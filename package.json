{
  "name": "weapp",
  "type": "module",
  "scripts": {
    "dev": "wv dev",
    "dev:open": "wv dev -o",
    "dev:ui": "wv dev --ui",
    "dev:open:ui": "wv dev --ui -o",
    "build": "wv build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p .weapp-vite/tsconfig.app.json",
    "open": "wv open",
    "analyze": "wv analyze",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue,wxss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,vue,wxss}\" --fix --allow-empty-input",
    "postinstall": "wv prepare"
  },
  "dependencies": {
    "tdesign-miniprogram": "^1.16.1"
  },
  "devDependencies": {
    "@icebreakers/eslint-config": "^7.1.3",
    "@icebreakers/stylelint-config": "^5.1.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/tailwind4": "^1.2.3",
    "@types/node": "^22.20.3",
    "@weapp-vite/dashboard": "^7.1.2",
    "eslint": "^10.10.0",
    "miniprogram-api-typings": "^5.2.3",
    "postcss": "^8.5.28",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "weapp-tailwindcss": "^5.5.5",
    "weapp-vite": "^7.1.2",
    "wevu": "^7.1.2"
  },
  "private": true
}
